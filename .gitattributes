# Keep source diffs stable between Windows development and Linux CI.
* text=auto

*.py       text eol=lf
*.ps1      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf
*.tsv      text eol=lf
*.xml      text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Models, media, Office files, and archives must never receive line conversion.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.wav      binary
*.mp4      binary
*.onnx     binary
*.pt       binary
*.pth      binary
*.npz      binary
*.joblib   binary
*.pdf      binary
*.ppt      binary
*.pptx     binary
*.docx     binary
*.ipynb    binary
*.zip      binary
